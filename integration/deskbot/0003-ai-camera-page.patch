+static bool _npu_pages_available(void)
 {
+    FILE *file = fopen("/proc/buddyinfo", "r");
+    if (!file)
+        return true;
+    char line[256];
+    bool checked = false, available = false;
+    while (fgets(line, sizeof(line), file)) {
+        char *cursor = strstr(line, "Normal");
+        if (!cursor)
+            continue;
+        cursor += strlen("Normal");
+        for (int order = 0; order < 12; ++order) {
+            char *end = NULL;
+            long blocks = strtol(cursor, &end, 10);
+            if (end == cursor)
+                break;
+            if (order >= 5 && blocks > 0)
+                available = true;
+            if (order >= 5)
+                checked = true;
+            cursor = end;
+        }
+    }
+    fclose(file);
+    return !checked || available;
+}
+
