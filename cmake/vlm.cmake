set(ECHO_RKLLM_ROOT "${CMAKE_SOURCE_DIR}/build/rkllm" CACHE PATH "Pinned SDK fetched by scripts/fetch_rkllm.py")
if(NOT EXISTS "${ECHO_RKLLM_ROOT}/include/rkllm.h")
  message(FATAL_ERROR "Run scripts/fetch_rkllm.py first")
endif()
find_package(Qt5 REQUIRED COMPONENTS Gui)
find_package(PkgConfig REQUIRED)
pkg_check_modules(SWS REQUIRED IMPORTED_TARGET libswscale libavutil)
add_executable(echotrace-vlm native/vlm/main.cpp ${ECHO_RKLLM_ROOT}/src/image_enc.cc)
target_include_directories(echotrace-vlm PRIVATE ${ECHO_RKLLM_ROOT}/include)
target_link_libraries(echotrace-vlm PRIVATE echo_json Qt5::Gui PkgConfig::SWS ${ECHO_RKLLM_ROOT}/lib/librkllmrt.so ${ECHO_RKLLM_ROOT}/lib/librknnrt.so)
set_target_properties(echotrace-vlm PROPERTIES BUILD_RPATH "${ECHO_RKLLM_ROOT}/lib" INSTALL_RPATH "$ORIGIN/../lib")
install(TARGETS echotrace-vlm DESTINATION bin)
