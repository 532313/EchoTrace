set(ECHO_LVGL_ROOT "" CACHE PATH "Existing Echo-Mate LVGL 9 source directory")
if(NOT EXISTS "${ECHO_LVGL_ROOT}/lvgl.h")
  message(FATAL_ERROR "ECHO_LVGL_ROOT must point to DeskBot_demo/lvgl")
endif()
set(LV_CONF_PATH "${CMAKE_SOURCE_DIR}/native/lvgl/lv_conf.h" CACHE STRING "LVGL configuration" FORCE)
set(LV_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(LV_BUILD_DEMOS OFF CACHE BOOL "" FORCE)
add_subdirectory(${ECHO_LVGL_ROOT} ${CMAKE_BINARY_DIR}/lvgl)
add_executable(echotrace-terminal native/lvgl/main.cpp ${ECHO_VENDOR_DIR}/fonts/echotrace_font.c)
target_link_libraries(echotrace-terminal PRIVATE lvgl echo_core m)
install(TARGETS echotrace-terminal DESTINATION bin)
