find_package(Qt5 5.12 REQUIRED COMPONENTS Core Gui Widgets Network)
find_package(PkgConfig REQUIRED)
pkg_check_modules(AV REQUIRED IMPORTED_TARGET libavformat libavcodec libavutil libswscale)
set(CMAKE_AUTOMOC ON)
if(NOT EXISTS "${ECHO_VENDOR_DIR}/decoder/RecordingPlayer.cpp")
  message(FATAL_ERROR "Run scripts/prepare_sources.py first")
endif()
add_library(echo_evidence_playback native/qt/EvidencePlayback.cpp native/qt/EvidencePlayback.h
  ${ECHO_VENDOR_DIR}/decoder/RecordingPlayer.cpp ${ECHO_VENDOR_DIR}/decoder/RecordingPlayer.h
  ${ECHO_VENDOR_DIR}/decoder/FFmpegDecoder.cpp ${ECHO_VENDOR_DIR}/decoder/FFmpegDecoder.h)
target_include_directories(echo_evidence_playback PUBLIC native/qt ${ECHO_VENDOR_DIR}/decoder)
target_link_libraries(echo_evidence_playback PUBLIC Qt5::Widgets Qt5::Network PkgConfig::AV Threads::Threads)
add_executable(echotrace-workbench native/qt/main.cpp)
target_link_libraries(echotrace-workbench PRIVATE echo_evidence_playback)
add_executable(echotrace-playback-test native/tests/qt_playback_test.cpp)
target_link_libraries(echotrace-playback-test PRIVATE echo_evidence_playback)
install(TARGETS echotrace-workbench DESTINATION bin)

if(ECHO_BUILD_MPP)
  find_library(MPP_LIBRARY rockchip_mpp REQUIRED)
  find_library(RGA_LIBRARY rga REQUIRED)
  add_executable(echotrace-frame native/media/extract.cpp ${ECHO_VENDOR_DIR}/decoder/MppDecoder.cpp)
  target_compile_definitions(echotrace-frame PRIVATE PLATFORM_RK3576)
  target_include_directories(echotrace-frame PRIVATE ${ECHO_VENDOR_DIR}/decoder native/media)
  target_link_libraries(echotrace-frame PRIVATE Qt5::Gui PkgConfig::AV ${MPP_LIBRARY} ${RGA_LIBRARY})
  install(TARGETS echotrace-frame DESTINATION bin)
endif()
